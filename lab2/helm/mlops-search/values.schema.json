{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["image", "rankingMode", "environment", "replicaCount"],
  "properties": {
    "strategy": {
      "type": "object",
      "required": ["maxUnavailable", "maxSurge"],
      "properties": {
        "maxUnavailable": {"type": "integer", "minimum": 0, "maximum": 1},
        "maxSurge": {"type": "integer", "minimum": 0, "maximum": 1}
      },
      "anyOf": [
        {"properties": {"maxUnavailable": {"const": 1}}},
        {"properties": {"maxSurge": {"const": 1}}}
      ],
      "additionalProperties": false
    },
    "replicaCount": {"type": "integer", "minimum": 1, "maximum": 3},
    "rankingMode": {"type": "string", "enum": ["normal", "reverse"]},
    "environment": {"type": "string", "enum": ["staging", "production"]},
    "buildRevision": {"type": "string", "minLength": 1},
    "image": {
      "type": "object",
      "required": ["repository", "digest", "pullPolicy"],
      "properties": {
        "repository": {"type": "string", "pattern": "^[a-z0-9][a-z0-9./:_-]*$"},
        "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "pullPolicy": {"type": "string", "enum": ["IfNotPresent", "Always"]}
      },
      "additionalProperties": false
    },
    "service": {
      "type": "object",
      "required": ["port"],
      "properties": {"port": {"type": "integer", "minimum": 1, "maximum": 65535}}
    }
  }
}
